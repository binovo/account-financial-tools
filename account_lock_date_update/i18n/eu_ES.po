#. module: account_lock_date_update
#: model:ir.model.fields,help:account_lock_date_update.field_account_update_lock_date__tax_lock_date
msgid ""
"No users can edit journal entries related to a tax prior and inclusive of "
"this date."
msgstr ""
"Erabiltzaileek ezin dituzte editatu data honen aurreko eta data honetako zergekin lotutako egunkari-idazpenak."

#. module: account_lock_date_update
#: model:ir.model.fields,help:account_lock_date_update.field_account_update_lock_date__fiscalyear_lock_date
msgid ""
"No users, including Advisers, can edit accounts prior to and inclusive of "
"this date. Use it for fiscal year locking for example."
msgstr ""
"Erabiltzaileek, aholkulariek barne, ezin dituzte editatu data honen aurreko eta data honetako kontuak. Besteak beste, zerga-urte bat blokeatzeko erabil dezakezu."

#. module: account_lock_date_update
#: model:ir.model.fields,help:account_lock_date_update.field_account_update_lock_date__period_lock_date
msgid ""
"Only users with the 'Adviser' role can edit accounts prior to and inclusive "
"of this date. Use it for period locking inside an open fiscal year, for "
"example."
msgstr ""
"'Aholkulari' funtzioa duten erabiltzaileek soilik edita ditzakete data horren aurreko eta data horretako kontuak. Besteak beste, zerga-urteen baitan epeak blokeatzeko erabili ditzakezu."

